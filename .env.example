# Desenvolvimento local. As senhas abaixo pertencem apenas ao PostgreSQL local
# restrito a 127.0.0.1. Em Compose, gere senhas próprias (preferencialmente hex).
PULSO_ENVIRONMENT=development
PULSO_DATABASE_URL=postgresql+psycopg://pulso_app:pulso-local-only@127.0.0.1:55432/pulso
PULSO_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:pulso-local-only@127.0.0.1:55432/pulso
PULSO_APP_ROLE_PASSWORD=pulso-local-only
PULSO_ORIGIN=http://127.0.0.1:3000
PULSO_COOKIE_SECURE=false
PULSO_COLLECTION_ENABLED=false
PULSO_MS_TOKEN=
PULSO_OLLAMA_URL=http://127.0.0.1:11434
PULSO_OLLAMA_MODEL=
PULSO_VISION_MODEL=
PULSO_CLASSIFIER_MODEL=
PULSO_CLASSIFIER_CALIBRATED=false
PULSO_WHISPER_MODEL_PATH=
# Use caminho absoluto para compartilhar os mesmos pesos entre API e workers.
PULSO_POSE_MODEL_PATH=
PULSO_TELEMETRY_ENABLED=false
PULSO_RETENTION_DAYS=90

# Compose: configure estes valores antes de executar.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
GRAFANA_PASSWORD=
